# Optional. Defaults run the local synthetic demo on port 3240.
# Do not point these at private data unless you own the data and understand access.
# ATLAS_DATA_DIR=/absolute/path/to/local/demo-or-catalog
# ATLAS_CATALOG_DB=/absolute/path/to/catalog.sqlite
# ATLAS_IMAGES_DB=/absolute/path/to/images.sqlite
# ATLAS_PILOT_DB=/absolute/path/to/pilot.sqlite
# ATLAS_FLAGSHIP_DB=/absolute/path/to/flagship.sqlite
# ATLAS_BOX_INDEX=/absolute/path/to/boxes.json
# ATLAS_IMAGE_ROOT=/absolute/path/to/images
# ATLAS_BOX_ROOT=/absolute/path/to/box-images
# ATLAS_PILOT_SERIES_ID=your-legacy-pilot-series-id
# ATLAS_DOCUMENT_ROOT=/absolute/path/to/your-authorized-pdfs
# ATLAS_COMMUNITY_DIR=/absolute/path/to/private/member-storage
# Only when correctly configuring an HTTPS host; not a Vercel-ready switch.
# ATLAS_PUBLIC_ORIGIN=https://your-domain.example
